# Runtime secrets are injected via Coolify environment variables.
# Do not commit real values to .env

# Use SQLite locally by default:
DATABASE_URL=sqlite:///./app.db

# In Docker (SQLite):
# DATABASE_URL=sqlite:////data/app.db

# In Docker (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db

LOG_LEVEL=INFO
