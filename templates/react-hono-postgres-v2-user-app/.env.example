PORT=3000
DATABASE_URL=postgresql://fakeuser:fakepassword@localhost:5432/fakedb
BETTER_AUTH_SECRETS=1:generate-a-real-secret-at-least-32-chars-long
BETTER_AUTH_URL=https://replace-with-origin
# Mandatory in production: comma-separated Traefik CIDR/IP list so multi-hop
# X-Forwarded-For resolves to the real client IP (rate limiting per client,
# not global). Boot refuses to start in production without it.
# Direct dev/test runs (localhost, no proxy) may omit it.
# BETTER_AUTH_TRUSTED_PROXIES=100.64.0.0/10
# Runtime role URL for the server; owner/migration URL goes to
# MIGRATION_DATABASE_URL (see README).
