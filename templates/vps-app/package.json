{
  "name": "vps-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "echo 'Run dev:server and dev:client in separate terminals' && exit 1",
    "dev:server": "NODE_ENV=development tsx --watch source/server/server.ts",
    "dev:client": "NODE_ENV=development vite",
    "build": "vite build && tsc -p tsconfig.server.json && node scripts/build-metadata.mjs",
    "start": "node dist/server/server/server.js",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests/unit.test.ts tests/readiness.test.ts tests/runner.test.ts",
    "test:integration": "bash tests/run-integration.sh",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tests.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx source/server/migrate.ts",
    "admin:seed-user": "tsx source/server/admin-cli.ts seed-user",
    "admin:reset-password": "tsx source/server/admin-cli.ts reset-password",
    "admin:revoke-sessions": "tsx source/server/admin-cli.ts revoke-sessions",
    "check": "npm run typecheck && npm run test:unit && npm run test:integration && npm run build",
    "test:image": "bash tests/image-smoke.sh"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@node-rs/argon2": "2.2.1",
    "better-auth": "1.7.18",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "pg": "^8.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^8.2.2",
    "vitest": "^5.1.0"
  }
}
