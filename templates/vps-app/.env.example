# Placeholders only. Broker injects runtime-only secrets; never commit .env.
DATABASE_URL=postgresql://app_runtime:<64-hex-runtime-password>@<db-uuid>:5432/postgres
MIGRATION_DATABASE_URL=postgresql://postgres:<url-encoded-owner-password>@<db-uuid>:5432/postgres
BETTER_AUTH_SECRETS=1:replace-with-generated-secret-at-least-32-characters
BETTER_AUTH_URL=https://__APP_SLUG__.studio.example
# Exact measured proxy hops only; reject whole client networks and 0.0.0.0/0.
BETTER_AUTH_TRUSTED_PROXIES=<measured-proxy-cidr>
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<generated-admin-password>
NODE_ENV=production
PORT=3000
