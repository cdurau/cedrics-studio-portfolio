{
  "$schema": "http://json-schema.org/draft/2020-12/schema",
  "title": "Phase 11 App Brief Schema",
  "description": "Canonical schema for app-brief.json files in the Phase 11 orchestration workflow",
  "type": "object",
  "required": ["schema", "app", "profile_selection", "metadata"],
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1,
      "description": "Schema version (must be 1)"
    },
    "app": {
      "type": "object",
      "required": ["name", "slug", "purpose", "requirements"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable application name"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "URL-safe application slug"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "description": "Brief description of application purpose"
        },
        "requirements": {
          "type": "object",
          "required": [
            "shared_state",
            "python_needed",
            "ssr_rsc_needed",
            "sqlite_sufficient",
            "path_safe",
            "own_origin_needed",
            "forward_auth_sufficient",
            "shadcn_needed",
            "backend_needed"
          ],
          "properties": {
            "shared_state": {"type": "boolean"},
            "python_needed": {"type": "boolean"},
            "ssr_rsc_needed": {"type": "boolean"},
            "sqlite_sufficient": {"type": "boolean"},
            "path_safe": {"type": "boolean"},
            "own_origin_needed": {"type": "boolean"},
            "forward_auth_sufficient": {"type": "boolean"},
            "shadcn_needed": {"type": "boolean"},
            "backend_needed": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "ui_requirements": {
          "type": "object",
          "properties": {
            "mobile_first": {"type": "boolean"},
            "pwa": {"type": "boolean"},
            "framework": {"type": "string"},
            "styling": {"type": "string"}
          }
        },
        "tests": {
          "type": "object",
          "properties": {
            "unit": {"type": "boolean"},
            "integration": {"type": "boolean"},
            "e2e_browser": {"type": "boolean"},
            "health_check": {"type": "boolean"},
            "persistence_check": {"type": "boolean"}
          }
        },
        "acceptance_gates": {
          "type": "array",
          "items": {"type": "string"}
        },
        "non_goals": {
          "type": "array",
          "items": {"type": "string"}
        },
        "allowed_external_actions": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "profile_selection": {
      "type": "object",
      "required": ["profile", "rationale"],
      "properties": {
        "profile": {
          "type": ["string", "null"],
          "enum": ["static-vite", "react-hono-sqlite", "react-hono-postgres", "next-postgres", "python-fastapi", "python-service", null],
          "description": "Selected profile (null if escalated)"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable rationale for profile selection or escalation"
        },
        "is_escalated": {
          "type": "boolean",
          "description": "Whether this brief requires escalation"
        },
        "escalation_reason": {
          "type": ["string", "null"],
          "description": "Reason for escalation (null if not escalated)"
        }
      },
      "additionalProperties": false
    },
    "orchestration": {
      "type": "object",
      "required": [],
      "properties": {
        "executor_type": {
          "type": "string",
          "description": "Type of executor (adapter-specific, e.g., 'agy', 'codex', 'opencode')"
        },
        "review_required": {
          "type": "boolean",
          "description": "Whether independent senior review is required"
        },
        "external_task_id": {
          "type": ["string", "null"],
          "description": "Adapter-specific task tracking ID (null if not yet created)"
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": ["created_at", "created_by"],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp"
        },
        "created_by": {
          "type": "string",
          "description": "Agent or user who created this brief"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
