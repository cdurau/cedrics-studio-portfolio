{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "executor-result.schema.json",
  "title": "Portable Executor Result",
  "description": "Agent-neutral structured result contract for bounded implementation executors.",
  "type": "object",
  "required": [
    "status",
    "summary",
    "files_changed",
    "tests",
    "warnings",
    "architecture_blockers",
    "recommended_follow_up"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "FAILED", "ARCHITECTURE_BLOCKER"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "files_changed": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "exit_code", "result"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
          "result": {"type": "string", "enum": ["passed", "failed"]}
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "architecture_blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "recommended_follow_up": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "SUCCESS"}}, "required": ["status"]},
      "then": {
        "properties": {
          "tests": {
            "minItems": 1,
            "items": {
              "properties": {
                "exit_code": {"const": 0},
                "result": {"const": "passed"}
              }
            }
          },
          "architecture_blockers": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "ARCHITECTURE_BLOCKER"}}, "required": ["status"]},
      "then": {
        "properties": {
          "files_changed": {"maxItems": 0},
          "tests": {"maxItems": 0},
          "architecture_blockers": {"minItems": 1}
        }
      }
    }
  ]
}
