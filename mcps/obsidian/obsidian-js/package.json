{
  "name": "obsidian-vault-mcp",
  "version": "0.1.0",
  "description": "MCP-Server für Obsidian Vaults – Multi-Vault, stdio + Streamable HTTP, arbeitet direkt auf den Markdown-Dateien (kein Obsidian-Plugin nötig).",
  "type": "module",
  "bin": {
    "obsidian-vault-mcp": "dist/obsidian-vault-mcp.mjs"
  },
  "main": "dist/obsidian-vault-mcp.mjs",
  "files": [
    "dist/obsidian-vault-mcp.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run typecheck && node scripts/bundle.mjs",
    "bundle": "node scripts/bundle.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/obsidian-vault-mcp.mjs",
    "start:http": "node dist/obsidian-vault-mcp.mjs --http",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run bundle",
    "inspect": "npx @modelcontextprotocol/inspector node dist/obsidian-vault-mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "mcp",
    "obsidian",
    "model-context-protocol",
    "markdown",
    "knowledge-base"
  ]
}
